# ========== 指导文档不需要上传 ==========
docs/

# ========== 模型权重、大checkpoint 绝对不上传 ==========
*.pth
*.bin
*.safetensors
*.ckpt
checkpoints/
weights/
saved_models/
/models/

# ========== 运行输出、日志 ==========
output/
logs/
runs/
results/

# ========== kvcache-tracer 的 trace 产出 ==========
# 事件文件体积随请求量增长，不该进版本库
kvcache_trace*.jsonl
kvcache_trace*.json
kvcache-tracer/traces/
kvcache-tracer/logs/
*.egg-info/

# 同一类产出的**分实验目录**。上面那条只挡住了 `traces/` 这一个名字，
# 而实际跑出来的目录叫 traces-skew / traces-policy / traces-step，
# 于是约 57 MB 的原始 trace 差点以"未跟踪文件"的身份被整个提交进来 ——
# 文件名还带着 pid（lru.172140.jsonl），一看就是跑出来的，不是手写的。
# 生成的 policy_thresholds.h 已在库里，构建不依赖这些文件。
kvcache-tracer/traces-*/
kvcache-tracer/results-*/

# ========== 数据集（体积大，放服务器本地磁盘） ==========
data/
datasets/

# ========== Python缓存 ==========
__pycache__/
*.pyc
*.pyo
*.pyd

# ========== 环境配置、本地路径配置 ==========
venv/
.env
*.env

# ========== IDE编辑器缓存 ==========
.vscode/
.idea/

# ========== 其他临时文件 ==========
*.tmp
*.log
